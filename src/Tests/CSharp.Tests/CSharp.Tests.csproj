<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Roslynator.CSharp.Tests</AssemblyName>
    <RootNamespace>Roslynator.CSharp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- SyntaxKindTests references SyntaxKind members that were added in later Roslyn versions.
       Guard them so the project also builds when pinned to an older RoslynatorTestRoslynVersion. -->
  <PropertyGroup>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RoslynatorTestRoslynVersion)', '4.11'))">$(DefineConstants);ROSLYN_TEST_4_11_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RoslynatorTestRoslynVersion)', '4.12'))">$(DefineConstants);ROSLYN_TEST_4_12_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RoslynatorTestRoslynVersion)', '4.14'))">$(DefineConstants);ROSLYN_TEST_4_14_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <DotNetCliToolReference Include="dotnet-xunit" Version="2.3.1" />
  </ItemGroup>

  <!-- Pins the Roslyn version this test project runs against. Override with /p:RoslynatorTestRoslynVersion=<version>. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynatorTestRoslynVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CSharp\CSharp.csproj" />
    <ProjectReference Include="..\Testing.CSharp\Testing.CSharp.csproj" />
    <ProjectReference Include="..\Tests.Common\Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="CSharp.Tests.snk" />
  </ItemGroup>

</Project>
